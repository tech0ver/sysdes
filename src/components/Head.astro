---
import StarlightHead from '@astrojs/starlight/components/Head.astro';

const socialImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/social-preview.png`, Astro.site);
const socialImageAlt = 'SystemDesign0ver — system design materials for interview preparation.';
---

<StarlightHead />

<meta property="og:image" content={socialImage.href} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:image" content={socialImage.href} />
<meta name="twitter:image:alt" content={socialImageAlt} />

{import.meta.env.PROD && (
	<>
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VNTPF3GXX8"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { window.dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-VNTPF3GXX8');
		</script>
	</>
)}
