---
// One button that switches between dark and light. The first visit follows the
// browser's color scheme (Starlight's ThemeProvider sets it before paint); a
// click stores the explicit choice under the same key Starlight uses.
import { Icon } from '@astrojs/starlight/components';
const label = 'Toggle theme';
---

<site-theme-toggle>
  <button type="button" class="site-theme-toggle" aria-label={label} title={label}>
    <Icon size="1.25rem" name="moon" class="site-theme-icon site-theme-moon" />
    <Icon size="1.25rem" name="sun" class="site-theme-icon site-theme-sun" />
  </button>
</site-theme-toggle>

<script>
  const storageKey = 'starlight-theme';
  const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

  class SiteThemeToggle extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem(storageKey, next); } catch {}
      });
    }
  }
  customElements.define('site-theme-toggle', SiteThemeToggle);

  // Until the reader picks a theme, follow changes of the system scheme.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    let stored = null;
    try { stored = localStorage.getItem(storageKey); } catch {}
    if (stored !== 'light' && stored !== 'dark') document.documentElement.dataset.theme = system();
  });
</script>

<style>
  /* Size, border and hover come from the shared header control style (ui.css). */
  .site-theme-toggle {
    display: inline-flex;
    padding: 0;
  }
  .site-theme-toggle :global(.site-theme-icon) {
    font-size: 1.25rem;
  }
  /* Show what a click will switch to: the moon in light mode, the sun in dark mode. */
  :global(:root[data-theme='light']) .site-theme-toggle :global(.site-theme-sun),
  :global(:root:not([data-theme='light'])) .site-theme-toggle :global(.site-theme-moon) {
    display: none;
  }
</style>
