---
import { Code } from '@astrojs/starlight/components';

interface Props {
  title: string;
  sourcePath: string;
}

const { title, sourcePath } = Astro.props;
const sourceUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${sourcePath.replace(/\.mdx?$/, '.md')}`, Astro.site).href;
const prompt = `Help me study "${title}" for practical system design:
${sourceUrl}

Ask my goal and preferred depth: a quick recap, a walkthrough, or a deeper discussion of trade-offs. Cover the whole article or suggest relevant sections. Use its examples, flag your additions, and let me set the pace.`;
---

<details class="article-tutor" data-pagefind-ignore>
  <summary><span>Concise article — AI can help</span><span aria-hidden="true">🤖</span></summary>
  <div class="tutor-content">
    <p>Copy this prompt and paste it into your AI chat:</p>
    <Code code={prompt} lang="text" wrap />
    <p>Or give your AI the article link with your own prompt:</p>
    <Code code={sourceUrl} lang="text" wrap class="tutor-link" />
  </div>
</details>

<style>
  .article-tutor {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.65rem;
    box-sizing: border-box;
    font-family: var(--sl-font), var(--sl-font-system);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }
  summary {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: calc(var(--sl-nav-height) - 2px);
    padding: 0.25rem 1rem;
    cursor: pointer;
    color: var(--sl-color-text-accent);
    font: inherit;
    list-style: none;
    text-decoration: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
  .tutor-content { padding: 1rem; }
  .tutor-content > p { margin-block: 0 0.6rem; }
  .tutor-content > p:not(:first-child) { margin-top: 1.25rem; }
  .tutor-content :global(.expressive-code pre > code) {
    font-family: var(--sl-font), var(--sl-font-system);
    font-size: var(--site-article-font-size);
    line-height: var(--site-article-line-height);
  }
  .tutor-content :global(.tutor-link pre > code) {
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }
  @media (max-width: 22.5rem) {
    summary { padding-inline: 0.375rem; gap: 0.375rem; }
  }
  @media print { .article-tutor { display: none; } }
</style>
