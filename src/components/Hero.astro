---
// Centered home page title, description and actions.
import SiteName from './SiteName.astro';
import LearningPyramid from './LearningPyramid.astro';
import { LinkButton } from '@astrojs/starlight/components';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="site-hero">
  <h1 id="_top" data-page-title>{title === 'SystemDesign0ver' ? <SiteName /> : <Fragment set:html={title} />}</h1>
  {tagline && <p class="site-hero-tagline" set:html={tagline} />}
  <div class="site-hero-actions">
    {actions.map(({ link: href, text, variant, icon }) => (
      <LinkButton {href} {variant} icon={icon?.name}>{text}</LinkButton>
    ))}
  </div>
  <LearningPyramid />
</div>

<style>
  .site-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem) 1rem;
    text-align: center;
  }

  /* The home page has no table of contents, so its content column can be wider. */
  :global(:root:has(.site-hero)) {
    --sl-content-width: 60rem;
  }

  h1 {
    text-wrap: balance;
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .site-hero-tagline {
    max-width: 50ch;
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }

  .site-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* Same height and shape as every other button on the site. */
  .site-hero-actions :global(.sl-link-button) {
    height: var(--site-control);
    padding: 0 0.25rem;
    border-radius: 0;
    font-size: var(--sl-text-sm);
    line-height: 1;
  }
</style>
